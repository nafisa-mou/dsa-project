# Smart Bus System - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Firebase Configuration
# ============================================
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_MESSAGING_SENDER_ID=your_firebase_sender_id
FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain

# ============================================
# Google Maps API
# ============================================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_MAPS_ANDROID_API_KEY=your_android_specific_key
GOOGLE_MAPS_IOS_API_KEY=your_ios_specific_key
GOOGLE_MAPS_WEB_API_KEY=your_web_specific_key

# ============================================
# Application Configuration
# ============================================
APP_VERSION=1.0.0
BUILD_NUMBER=1
APP_NAME=Smart Bus
APP_ENVIRONMENT=production  # development, staging, production

# ============================================
# System Tuning Parameters
# ============================================
PICKUP_REQUEST_TIMEOUT_MINUTES=15
LOCATION_SHARING_TIMEOUT_MINUTES=15
GPS_UPDATE_INTERVAL_SECONDS=30
MAX_PICKUP_DISTANCE_KM=5.0
PRIORITY_QUEUE_SIZE=500

# ============================================
# Algorithm Parameters
# ============================================
DIJKSTRA_MAX_ITERATIONS=1000
PICKUP_PRIORITY_WEIGHT_URGENCY=0.3
PICKUP_PRIORITY_WEIGHT_WAIT_TIME=0.3
PICKUP_PRIORITY_WEIGHT_DISTANCE=0.2
PICKUP_PRIORITY_WEIGHT_DESIRED_TIME=0.2

# ============================================
# Database Configuration
# ============================================
FIRESTORE_COLLECTION_PREFIX=prod_
REALTIME_DB_REGION=us-central1
BACKUP_RETENTION_DAYS=30

# ============================================
# Notification Settings
# ============================================
ENABLE_PICKUP_NOTIFICATIONS=true
ENABLE_ARRIVAL_NOTIFICATIONS=true
ENABLE_SYSTEM_NOTIFICATIONS=true
NOTIFICATION_SOUND=default

# ============================================
# Analytics & Logging
# ============================================
ENABLE_ANALYTICS=true
ENABLE_CRASH_REPORTING=true
LOG_LEVEL=info  # debug, info, warn, error
ANALYTICS_RETENTION_DAYS=90

# ============================================
# Server Configuration (if using custom backend)
# ============================================
BACKEND_URL=https://api.smartbus.example.com
API_TIMEOUT_SECONDS=30

# ============================================
# Feature Flags
# ============================================
ENABLE_QR_CODE_BOARDING=false
ENABLE_GEOFENCING=false
ENABLE_TRAFFIC_AWARE_ROUTING=true
ENABLE_SOS_EMERGENCY=true
ENABLE_SEAT_AVAILABILITY=false

# ============================================
# Development Configuration
# ============================================
ENABLE_DEBUG_MODE=false
ENABLE_MOCK_LOCATION=false
MOCK_BUS_COUNT=3
MOCK_STUDENT_COUNT=50

# ============================================
# Security
# ============================================
JWT_SECRET=your_jwt_secret_key
SESSION_TIMEOUT_MINUTES=60
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# ============================================
# Email Configuration (if used)
# ============================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=noreply@smartbus.example.com

# ============================================
# Storage Configuration
# ============================================
MAX_IMAGE_SIZE_MB=5
ALLOWED_IMAGE_FORMATS=jpg,jpeg,png,gif
STORAGE_BUCKET=your-firebase-storage-bucket
